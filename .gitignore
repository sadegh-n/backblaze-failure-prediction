# --------------------------------------------------
# 1. Data Files (CRITICAL)
# ---------------------------------------------------
*.csv
*.parquet
*.json
*.zip
*.tar
*.gz
*.sqlite
*.db

# Ignore any local data directories you might create
data/
raw/
processed/
temp/

# ---------------------------------------------------
# 2. Jupyter Notebooks & SageMaker
# ---------------------------------------------------
# Ignore hidden autosave checkpoints created by JupyterLab
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ignore SageMaker specific temporary files
.sparkmagic/
lost+found/

# ---------------------------------------------------
# 3. Python & Environments
# ---------------------------------------------------
# Ignore compiled byte-code
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
env/
.venv/
Pipfile.lock

# Ignore environment variables and secrets
.env
.secrets

# ---------------------------------------------------
# 4. OS Generated Files
# ---------------------------------------------------
.DS_Store
Thumbs.db
